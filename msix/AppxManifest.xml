<?xml version="1.0" encoding="utf-8"?>
<!--
  Microsoft Store (MSIX) package manifest for PiP Studio.
  The release workflow fills in the $...$ values from the repository variables
  MSIX_IDENTITY_NAME, MSIX_PUBLISHER and MSIX_PUBLISHER_DISPLAY_NAME (Partner Center >
  your app > Product management > Product identity), and the version from the tag.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap desktop rescap">

  <Identity Name="$IDENTITY_NAME$" Publisher="$PUBLISHER$" Version="$VERSION$" ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>PiP Studio</DisplayName>
    <PublisherDisplayName>$PUBLISHER_DISPLAY_NAME$</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="PiPStudio" Executable="PiPStudio.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="PiP Studio"
        Description="Picture-in-picture for any window, display or part of the screen"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
      </uap:VisualElements>
      <Extensions>
        <!-- "Start PiP Studio when I sign in" (Packaged.cs); off until you turn it on in Settings -->
        <desktop:Extension Category="windows.startupTask" Executable="PiPStudio.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="PiPStudioStartup" Enabled="false" DisplayName="PiP Studio" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <!-- a normal desktop app: it shows and controls other windows, uses global shortcuts and reads game controllers -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
