<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- the Windows 10 SDK version gives access to the Store version's startup task (Packaged.cs) -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>PiPStudio</AssemblyName>
    <RootNamespace>PipStudio</RootNamespace>
    <StartupObject>PipStudio.Program</StartupObject>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Product>PiP Studio</Product>
    <Description>Picture-in-picture for any window, display or part of the screen</Description>
    <Copyright>Copyright (c) 2026 NauticalNoodles</Copyright>
    <ApplicationIcon>PiPStudio.ico</ApplicationIcon>
    <Version>1.0.4</Version>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <ServerGarbageCollector>false</ServerGarbageCollector>
    <TieredPGO>false</TieredPGO>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <NoWarn>$(NoWarn);CA1416;CS0618;CS0414;CS0169;CS0649;WFAC010;WFO1000</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- the tests are a project of their own (tests/) -->
    <Compile Remove="tests\**" />
    <None Remove="tests\**" />
  </ItemGroup>
  <ItemGroup>
    <!-- the phone companion's page and icon, served by PiP Studio itself (Companion.cs) -->
    <EmbeddedResource Include="companion\index.html" LogicalName="companion.index.html" />
    <EmbeddedResource Include="companion\crypto.js" LogicalName="companion.crypto.js" />
    <EmbeddedResource Include="assets\icon.png" LogicalName="companion.icon.png" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="3.0.5" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
  </ItemGroup>
</Project>
