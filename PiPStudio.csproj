<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>PiPStudio</AssemblyName>
    <RootNamespace>PipStudio</RootNamespace>
    <StartupObject>PipStudio.Program</StartupObject>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Product>PiP Studio</Product>
    <Description>Picture-in-picture for any window, display or part of the screen</Description>
    <Copyright>Copyright (c) 2026 NauticalNoodles</Copyright>
    <ApplicationIcon>PiPStudio.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <ServerGarbageCollector>false</ServerGarbageCollector>
    <TieredPGO>false</TieredPGO>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <NoWarn>$(NoWarn);CA1416;CS0618;CS0414;CS0169;CS0649;WFAC010;WFO1000</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="3.0.5" />
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
  </ItemGroup>
</Project>
